{
	"name": "Vimium C",
	"autoDarkMode": 2,
	"clipSub": [
		"p=^git@([^/:]+):=https://$1/=",
		"s@^https://(?:www\\.)?google\\.com(?:\\.[^/]+)?/url\\?(?:[^&#]+&)*?url=([^&#]+)@$1@,matched,decodecomp",
		"r@^https://github\\.com/[^\\s\\/?#]+/[^\\s\\/?#]+(?=/)@@,matched",
		"si@^https?://link\\.zhihu\\.com/\\?target=@@,decodecomp",
		"g@^https://www\\.zhihu\\.com/question/\\d+(?=/answer/?$)@@,matched",
		"p@^https://item\\.m\\.jd\\.com/product/(\\d+)\\.html\\b@https://item.jd.com/$1.html@",
		""
	],
	"exclusionListenHash": false,
	"exclusionRules": [
		{ "pattern": "^https?://www\\.youtube\\.com/", "passKeys": "f j k l c m t i / " },
		{ "pattern": "^https?://mail\\.google\\.com/", "passKeys": "j k c r x z o / ? " },
		{ "pattern": "^https?://docs\\.google\\.com/", "passKeys": "" },
		{ "pattern": "^https?://www\\.notion\\.so/", "passKeys": "" },
		{ "pattern": "^https?://www\\.figma\\.com/", "passKeys": "" },
		{ "pattern": "^https?://github\\.com/", "passKeys": "t / c . " },
		{ "pattern": "^https?://www\\.reddit\\.com/", "passKeys": "j k c z x / " },
		{ "pattern": "^https?://x\\.com/", "passKeys": "j k l r n / " },
		{ "pattern": "^https?://chatgpt\\.com/", "passKeys": "/ " }
	],
	"grabBackFocus": true,
	"keyLayout": 2,
	"keyMappings": [
		"#!no-check",
		"unmapAll",
		"",
		"# === 1. Right Hand: Home Row (j/k = Scroll, h/l = Tabs) ===",
		"map j scrollDown",
		"map k scrollUp",
		"map J scrollPageDown",
		"map K scrollPageUp",
		"map h previousTab",
		"map l nextTab",
		"map H goBack",
		"map L goForward",
		"map gg scrollToTop",
		"map G scrollToBottom",
		"map , visitPreviousTab",
		"",
		"# === 2. Left Hand: ZXCV (Undo, Close, Copy, Paste) ===",
		"map z restoreTab",
		"map x removeTab goto=\"previous,near\" highlighted",
		"map c copyCurrentUrl",
		"map v openCopiedUrlInCurrentTab",
		"map V openCopiedUrlInNewTab",
		"",
		"# === 3. Single-Key First-Letter Actions ===",
		"map f LinkHints.activate",
		"map F LinkHints.activateOpenInNewTab",
		"map r reload",
		"map R reload hard",
		"map o Vomnibar.activate",
		"map O Vomnibar.activateInNewTab",
		"map t createTab",
		"map T Vomnibar.activateTabSelection",
		"map b Vomnibar.activateBookmarks",
		"map B Vomnibar.activateBookmarksInNewTab",
		"map / enterFindMode",
		"map n performFind",
		"map N performBackwardsFind",
		"",
		"# === 4. \"g\" Prefix Jumps (Top, Input, First/Last Tab, Frames) ===",
		"map gi focusInput",
		"map g0 firstTab",
		"map g$ lastTab",
		"map gf nextFrame",
		"map gF mainFrame",
		"",
		"# === 5. Space + First Letter (Toggles, Visual Mode & Side Scroll) ===",
		"map <space>p togglePinTab",
		"map <space>m toggleMuteTab",
		"map <space>d duplicateTab",
		"map <space>x closeOtherTabs",
		"map <space>v enterVisualMode",
		"map <space>h Vomnibar.activateHistoryInNewTab",
		"map <space>i enterInsertMode",
		"map <space>, scrollLeft",
		"map <space>. scrollRight",
		"",
		"# === 6. Essentials ===",
		"map i enterInsertMode",
		"map ? showHelp",
		""
	],
	"linkHintCharacters": "asdfghjkl",
	"nextPatterns": "下一封,下页,下一页,下一章,后一页,下一张,.btn-next,[data-slp-action=nextSlide]:not(div),next,more,newer,>,›,→,»,≫,>>",
	"previousPatterns": "上一封,上页,上一页,上一章,前一页,上一张,.btn-prev,[data-slp-action=prevSlide]:not(div),prev,previous,back,older,<,‹,←,«,≪,<<",
	"searchEngines": [
		"g|go|Google: https://www.google.com/search?ie=utf-8&q=$s blank=https://www.google.com Google",
		"y|yt: https://www.youtube.com/results?search_query=%s blank=https://www.youtube.com/ YouTube",
		"gh|github: https://github.com/search?q=$s blank=https://github.com GitHub",
		"w|wiki: https://en.wikipedia.org/w/index.php?title=Special:Search&search=$s Wikipedia",
		"d|ddg: https://duckduckgo.com/?q=%s DuckDuckGo",
		"r|reddit: https://www.reddit.com/search/?q=%s Reddit",
		"gm|gmap: https://www.google.com/maps?q=%s blank=https://www.google.com/maps Google Maps",
		"tr: https://translate.google.com/?ie=utf-8#auto/en/$s Google Translate",
		"mdn: https://developer.mozilla.org/en-US/search?q=$s MDN",
		"v.m|math: vimium://math\\ $S re= Calculate",
		"v.mc: vimium://search-copy\\ vimium://math\\ $S re= Calculate and Copy"
	],
	"showActionIcon": false,
	"vimSync": false
}